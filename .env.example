# ==============================================================================
# THOUGHTFLOW AI - ENVIRONMENT CONFIGURATION (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env' (or 'backend/.env'):
#    cp .env.example backend/.env
# 2. Fill in the values for the services you wish to enable.
# 3. NEVER commit your actual '.env' file or secret credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Environment & Security
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
# 64-character secret key used to encrypt OAuth refresh tokens at rest in SQLite/Postgres:
APP_SECRET_KEY=change_this_to_a_secure_random_64_char_string_for_production
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://localhost:8081","*"]

# ------------------------------------------------------------------------------
# 2. Server & Network
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 3. Database Persistence (Real Database per Rule 4)
# ------------------------------------------------------------------------------
# Default: SQLite (Zero external dependencies, ideal for local development & testing)
DATABASE_URL=sqlite:///./thoughtflow.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/thoughtflow_db

# ------------------------------------------------------------------------------
# 4. Storage Directories
# ------------------------------------------------------------------------------
STORAGE_DIR=./storage
VIDEO_STORAGE_DIR=./storage/videos
TEMP_STORAGE_DIR=./storage/temp

# ------------------------------------------------------------------------------
# 5. AI Text & Quote Generation (Rule 12 & 13: Free & Local First)
# ------------------------------------------------------------------------------
# Supported providers:
# - "gemini" : Free tier from Google AI Studio (Recommended, high quality)
#              Get a free API key at: https://aistudio.google.com/
# - "openai" : Paid tier (OpenAI GPT-4o-mini)
# - "mock"   : 100% offline local catalog (12 themes, zero API key required)
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 6. Video Rendering Engine (FFmpeg - Free & Local per Rule 12)
# ------------------------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
DEFAULT_VIDEO_WIDTH=1080
DEFAULT_VIDEO_HEIGHT=1920
DEFAULT_FPS=30
DEFAULT_VIDEO_DURATION_SECONDS=15

# ------------------------------------------------------------------------------
# 7. Text-to-Speech / Audio (Optional)
# ------------------------------------------------------------------------------
# Default: "none" (Generates animated typography video with ambient music)
TTS_PROVIDER=none
ELEVENLABS_API_KEY=
TTS_VOICE_ID=

# ------------------------------------------------------------------------------
# 8. YouTube Data API v3 & Google OAuth 2.0 (Rule 14: Safe Dry-Run)
# ------------------------------------------------------------------------------
# How to obtain credentials:
# 1. Open Google Cloud Console: https://console.cloud.google.com/
# 2. Enable "YouTube Data API v3".
# 3. Go to "Credentials" -> "Create Credentials" -> "OAuth 2.0 Client IDs".
# 4. Set Application Type to "Web application".
# 5. Add Authorized Redirect URI: http://localhost:8000/api/v1/youtube/callback
#
# NOTE: If credentials are left blank, ThoughtFlow AI operates in SAFE DRY-RUN MODE:
# videos are rendered and stored locally, and YouTube upload will not claim success.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/youtube/callback
YOUTUBE_UPLOAD_ENABLED=False
DEFAULT_VIDEO_PRIVACY=private
AUTO_PUBLISH_ENABLED=False

# ------------------------------------------------------------------------------
# 9. Autonomous Automation Worker & Scheduler
# ------------------------------------------------------------------------------
AUTOMATION_ENABLED=False
DAILY_GENERATION_TIME=07:00
DAILY_PUBLISHING_TIME=09:00
DEFAULT_TIMEZONE=UTC
MAX_DAILY_GENERATIONS=5
MAX_RETRY_ATTEMPTS=3
