# ==========================================
# THOUGHTFLOW AI - CONFIGURATION
# ==========================================

# Environment
ENVIRONMENT=development
DEBUG=True
APP_SECRET_KEY=change_this_to_a_secure_random_64_char_string_for_production
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://localhost:8081"]

# Server
HOST=0.0.0.0
PORT=8000

# Database
# Default: SQLite for immediate local dev/testing without external servers
# Production: postgresql+psycopg2://user:password@localhost:5432/thoughtflow_db
DATABASE_URL=sqlite:///./thoughtflow.db

# Storage
STORAGE_DIR=./storage
VIDEO_STORAGE_DIR=./storage/videos
TEMP_STORAGE_DIR=./storage/temp

# AI Provider Configuration
# Supported providers: "gemini", "openai", "local", "mock"
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# Media & Video Rendering
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
DEFAULT_VIDEO_WIDTH=1080
DEFAULT_VIDEO_HEIGHT=1920
DEFAULT_FPS=30
DEFAULT_VIDEO_DURATION_SECONDS=15

# Text-to-Speech / Audio Configuration
TTS_PROVIDER=none
ELEVENLABS_API_KEY=
TTS_VOICE_ID=

# YouTube Data API v3 (Google OAuth 2.0)
# Obtain from Google Cloud Console: APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/youtube/callback
YOUTUBE_UPLOAD_ENABLED=False
DEFAULT_VIDEO_PRIVACY=private
AUTO_PUBLISH_ENABLED=False

# Automation & Scheduler
AUTOMATION_ENABLED=False
DAILY_GENERATION_TIME=07:00
DAILY_PUBLISHING_TIME=09:00
DEFAULT_TIMEZONE=UTC
MAX_DAILY_GENERATIONS=5
MAX_RETRY_ATTEMPTS=3
